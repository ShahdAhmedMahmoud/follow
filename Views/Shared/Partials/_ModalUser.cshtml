@* modalUser *@
<div class="modal-overlay" id="modalUser">
    <div class="modal-card" style="max-width: 560px;">
        <div class="modal-header"><h3 class="modal-title" id="lblUserModal">إضافة مستخدم</h3><button type="button" class="modal-close" data-close-user>&times;</button></div>
        <div class="modal-body">
            <form id="formUser" class="form-grid" autocomplete="off">
                <input type="hidden" id="userEditId">
                <div class="form-group span-full"><label>اسم المستخدم *</label><input type="text" class="form-control" id="userUsername" required autocomplete="off"></div>
                <div class="form-group span-full"><label>الاسم الكامل *</label><input type="text" class="form-control" id="userDisplayName" required></div>
                <div class="form-group span-full"><label>البريد الإلكتروني *</label><input type="email" class="form-control" id="userEmail" required></div>
                <div class="form-group"><label>كلمة المرور <span id="userPasswordRequired">*</span></label>
                    <div class="password-wrap">
                        <input type="password" class="form-control" id="userPassword" autocomplete="new-password">
                        <button type="button" class="toggle-pass" data-toggle-pass="userPassword" title="إظهار/إخفاء">👁</button>
                    </div>
                </div>
                <div class="form-group"><label>تأكيد كلمة المرور <span id="userPassword2Required">*</span></label>
                    <div class="password-wrap">
                        <input type="password" class="form-control" id="userPassword2" autocomplete="new-password">
                        <button type="button" class="toggle-pass" data-toggle-pass="userPassword2" title="إظهار/إخفاء">👁</button>
                    </div>
                </div>
                <div class="form-group"><label>الدور *</label>
                    <select class="form-select" id="userRole">
                        <option value="Viewer">عرض فقط (Viewer)</option>
                        <option value="User">مستخدم (User)</option>
                        <option value="Admin">مدير النظام (Admin)</option>
                    </select>
                </div>
                <div class="form-group"><label>الحالة</label>
                    <select class="form-select" id="userStatus">
                        <option value="Active">نشط</option>
                        <option value="Inactive">غير نشط</option>
                    </select>
                </div>
                <div class="form-group span-full" id="userFormError" style="display:none;color:#b91c1c;font-size:0.85rem;"></div>
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-close-user>إلغاء</button>
            <button type="button" class="btn btn-primary" id="btnSaveUser">حفظ</button>
        </div>
    </div>
</div>

<!-- OWNER MODAL -->
