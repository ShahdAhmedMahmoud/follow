@* Invoices page *@
            <!-- INVOICES -->
            <div id="invoicesView" class="page-view">
                <div class="table-container">
                    <div class="table-toolbar">
                        <div class="table-toolbar-left"><input type="text" class="form-control table-search" id="searchInvoices" placeholder="بحث في جميع الأعمدة..."></div>
                        <div style="display: flex; gap: 0.75rem;"><button class="btn btn-primary" id="btnAddInvoice">+ مستخلص جديد</button></div>
                    </div>
                    
                    <div class="kpi-grid" id="invSummaryBar" style="padding: 1rem 1rem 0 1rem; margin-bottom: 0; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
                        <div class="kpi-card info">
                            <div class="kpi-label">عدد المستخلصات المعروضة</div>
                            <div class="kpi-value" id="invSummaryCount">0</div>
                        </div>
                        <div class="kpi-card success">
                            <div class="kpi-label">إجمالي قيمة المستخلصات (Gross)</div>
                            <div class="kpi-value" id="invSummaryGross" data-full="0.00">0.00</div>
                        </div>
                        <div class="kpi-card success">
                            <div class="kpi-label">إجمالي الصافي النقدي</div>
                            <div class="kpi-value" id="invSummaryNet" data-full="0.00">0.00</div>
                        </div>
                        <div class="kpi-card warning">
                            <div class="kpi-label">نسبة التحصيل</div>
                            <div class="kpi-value" id="invSummaryCollectionRate">0%</div>
                        </div>
                        <div class="kpi-card info">
                            <div class="kpi-label">متوسط مدة الصرف</div>
                            <div class="kpi-value" id="invSummaryAvgPaymentDays">0</div>
                            <div class="kpi-sub">يوم</div>
                        </div>
                    </div>

                    <div class="data-table-wrapper" style="margin-top: 1rem;">
                        <table class="data-table" id="tblInvoices">
                            <thead>
                                <tr><th>رقم المستخلص</th><th>العقد</th><th>المشروع</th><th>المالك</th><th>التاريخ</th><th>تاريخ الاستحقاق</th><th>الإجمالي</th><th>الصافي</th><th>الحالة</th><th>حالة السداد</th><th>الإجراءات</th></tr>
                            </thead>
                            <tbody></tbody>
                            <tfoot>
                                <tr>
                                    <td><strong>عدد المستخلصات: <span id="invFootCount">0</span></strong></td>
                                    <td colspan="5"></td>
                                    <td id="invFootGross">0.00</td>
                                    <td id="invFootNet">0.00</td>
                                    <td></td>
                                    <td><strong>متوسط الصرف: <span id="invFootAvgDays">0</span> يوم</strong></td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <div id="invoicesPagination"></div>
                </div>
            </div>

