@* Owners page *@
            <!-- OWNERS -->
            <div id="ownersView" class="page-view">
                <div class="table-container">
                    <div class="table-toolbar">
                        <div class="table-toolbar-left"><input type="text" class="form-control table-search" id="searchOwners" placeholder="بحث في جميع الأعمدة..."></div>
                        <div style="display:flex;gap:.5rem;align-items:center;">
                            <button class="btn btn-danger-outline btn-sm" id="btnDeleteAllOwners">🗑️ مسح الكل</button>
                            <button class="btn btn-primary" id="btnAddOwner">+ إضافة مالك</button>
                        </div>
                    </div>
                    <div class="data-table-wrapper">
                        <table class="data-table" id="tblOwners">
                            <thead>
                                <tr><th>الكود</th><th>الاسم</th><th>الهاتف</th><th>المشروعات</th><th>إجمالي المستخلصات</th><th>إجمالي المدفوع</th><th>الإجراءات</th></tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                    <div id="ownersPagination"></div>
                </div>
            </div>

