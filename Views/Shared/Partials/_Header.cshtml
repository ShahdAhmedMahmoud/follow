@* Top header *@
        <header id="header">
            <div class="header-start">
                <button type="button"
                        class="btn-mobile-menu"
                        id="btnMobileMenu"
                        aria-label="فتح القائمة"
                        title="القائمة">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M4 6h16M4 12h16M4 18h16"/>
                    </svg>
                </button>
                <h1 class="header-title" id="pageTitleDisplay">لوحة المتابعة</h1>
            </div>
            <div class="header-actions">
                <button class="btn btn-primary" id="btnQuickInvoice">+ مستخلص جديد</button>
                <div class="header-user">
                    <span class="header-user-name" id="headerUserName">—</span>
                    <button type="button" class="btn-logout" id="btnLogout">تسجيل الخروج</button>
                </div>
            </div>
        </header>